  shorttitle = {Feeling {{Politics}}},
  author = {Davis, Brandon Rudolph},
  date = {2021},
  journaltitle = {Policy Studies Journal},
  shortjournal = {Policy Stud. J.},
  volume = {49},
  number = {2},
